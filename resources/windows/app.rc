#pragma code_page(65001)
#include <winresrc.h>

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

1 ICON "../icons/app.ico"

1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "光剑曲谱制作项目贡献者\0"
            VALUE "FileDescription", "光剑曲谱制作\0"
            VALUE "FileVersion", "0.4.0\0"
            VALUE "InternalName", "LightsaberMusicalScoreCreation\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 光剑曲谱制作项目贡献者；GNU GPL v3\0"
            VALUE "OriginalFilename", "LightsaberMusicalScoreCreation.exe\0"
            VALUE "ProductName", "光剑曲谱制作\0"
            VALUE "ProductVersion", "0.4.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

# Local Beat Saber reference packages
/music/
/samples/beatmaps/*
!/samples/beatmaps/.gitkeep

# Local editor projects and their self-contained media snapshots
/projects/*
!/projects/.gitkeep

# Pinned FFmpeg binaries are restored by scripts/setup-audio-tools.ps1.
/third_party/ffmpeg/bin/

# Qt / CMake build outputs and local IDE settings
/build*/
/out/
/dist/
cmake-build-*/
.idea/
/.qt/
/.vs/
*.pro.user
*.pro.user.*
*.qmlproject.user
*.qmlproject.user.*
*.autosave
.qmake.stash
CMakeUserPresets.json

# Local environments and caches
/.venv/
/venv/
__pycache__/
*.py[cod]

# Local secrets
.env
.env.*
!.env.example
